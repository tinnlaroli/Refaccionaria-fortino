# Refaccionaria Fortino — variables para despliegue en producción
# Copia a .env y ajusta valores antes de: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# PostgreSQL
# Nota: la contraseña solo aplica al CREAR el volumen de Postgres.
# Si ya corriste docker compose antes, usa la misma contraseña o borra datos con: docker compose down -v
POSTGRES_USER=refaccionaria
POSTGRES_PASSWORD=refaccionaria_dev
POSTGRES_DB=refaccionaria

# API
JWT_SECRET=change-me-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Gateway (puerto expuesto al host)
GATEWAY_PORT=8080
