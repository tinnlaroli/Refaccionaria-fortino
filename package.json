{
  "name": "refaccionaria-fortino",
  "private": true,
  "version": "0.1.0",
  "description": "POS e inventario offline-first para refaccionaria",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up --build -d",
    "db:migrate": "npm run migrate -w @refaccionaria/db",
    "db:seed": "npm run seed -w @refaccionaria/db",
    "db:build": "npm run build -w @refaccionaria/db",
    "api:dev": "npm run build -w @refaccionaria/db && npm run dev -w @refaccionaria/api",
    "branch:api": "git checkout feat/api",
    "branch:ux": "git checkout feat/ux",
    "branch:landing": "git checkout feat/landing",
    "branch:bd": "git checkout feat/bd",
    "branch:main": "git checkout main",
    "sync:branches": "powershell -ExecutionPolicy Bypass -File scripts/sync-branches.ps1"
  }
}
